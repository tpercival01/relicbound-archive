---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Relicbound | The Walking Museum"
  description="Relicbound finds nearby walking expeditions and rewards completed routes with lost relics for a persistent museum collection."
>
  <section class="hero">
    <p class="eyebrow">A walking collection game for iPhone</p>

    <h1>Let the walk choose the destination.</h1>

    <p class="introduction">
      Relicbound finds nearby walking expeditions, guides you through Apple
      Maps and rewards every completed route with sealed cases containing
      relics from four lost civilisations.
    </p>

    <div class="actions">
      <a class="primary-action" href="/how-it-works">How It Works</a>
      <a class="secondary-action" href="/archive">Explore the Archive</a>
    </div>

    <dl class="facts">
      <div>
        <dt>105</dt>
        <dd>Relics</dd>
      </div>

      <div>
        <dt>4</dt>
        <dd>Lost civilisations</dd>
      </div>

      <div>
        <dt>£1.99</dt>
        <dd>One-time purchase</dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100vh - 16rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
    color: var(--colour-accent-bright);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin-bottom: 1.5rem;
  }

  .introduction {
    max-width: 42rem;
    margin-bottom: 2rem;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary-action,
  .secondary-action {
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--colour-accent);
    border-radius: 0.35rem;
    font-weight: 700;
    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .primary-action {
    background: var(--colour-accent);
    color: var(--colour-background);
  }

  .primary-action:hover {
    background: var(--colour-accent-bright);
    border-color: var(--colour-accent-bright);
  }

  .secondary-action {
    color: var(--colour-accent-bright);
  }

  .secondary-action:hover {
    background: rgba(202, 169, 104, 0.08);
    border-color: var(--colour-accent-bright);
  }

  .facts {
    width: min(100%, 42rem);
    margin: clamp(3rem, 8vw, 6rem) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--colour-border);
  }

  .facts div {
    padding: 1.25rem;
    text-align: center;
  }

  .facts div + div {
    border-left: 1px solid var(--colour-border);
  }

  .facts dt {
    color: var(--colour-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
  }

  .facts dd {
    margin: 0.25rem 0 0;
    color: var(--colour-text-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 34rem) {
    .actions,
    .primary-action,
    .secondary-action {
      width: 100%;
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .facts div + div {
      border-top: 1px solid var(--colour-border);
      border-left: 0;
    }
  }
</style>