---
import type { Relic } from "../../../data/relics";
import { relics } from "../../../data/relics";
import { getCivilisation } from "../../../data/civilisations";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return relics.map((relic) => {
    const civilisationRelics = relics
      .filter(
        (candidate) =>
          candidate.civilisationSlug === relic.civilisationSlug,
      )
      .sort(
        (first, second) =>
          first.collectionNumber - second.collectionNumber,
      );

    const currentIndex = civilisationRelics.findIndex(
      (candidate) => candidate.id === relic.id,
    );

    return {
      params: {
        slug: relic.slug,
      },
      props: {
        relic,
        previousRelic:
          currentIndex > 0
            ? civilisationRelics[currentIndex - 1]
            : undefined,
        nextRelic:
          currentIndex < civilisationRelics.length - 1
            ? civilisationRelics[currentIndex + 1]
            : undefined,
      },
    };
  });
}

interface Props {
  relic: Relic;
  previousRelic?: Relic;
  nextRelic?: Relic;
}

const { relic, previousRelic, nextRelic } = Astro.props;

const civilisation = getCivilisation(relic.civilisationSlug);

const rarityLabels: Record<Relic["rarity"], string> = {
  common: "Common",
  uncommon: "Uncommon",
  rare: "Rare",
  centrepiece: "Centrepiece",
};

const rarityLabel = rarityLabels[relic.rarity];
const hasExtendedArchive =
  Boolean(relic.archiveEntry) ||
  Boolean(relic.curatorNote) ||
  Boolean(relic.historicalInterpretation);
---

<BaseLayout
  title={`${relic.name} | The Relicbound Archive`}
  description={relic.appDescription}
>
  <a
    class='back-link'
    href={`/archive/civilisations/${relic.civilisationSlug}`}
  >
    ← Return to {civilisation?.name ?? "the Archive"}
  </a>

  <article class='relic-record'>
    <div
      class={`artwork rarity-${relic.rarity}`}
      role='img'
      aria-label={relic.altText}
    >
      <span>Artwork awaiting restoration</span>
    </div>

    <div class='relic-information'>
      <p class='eyebrow'>
        {civilisation?.name ?? "Unknown civilisation"}
      </p>

      <h1>{relic.name}</h1>

      <dl class='metadata'>
        <div>
          <dt>Collection record</dt>
          <dd>{String(relic.collectionNumber).padStart(2, "0")}</dd>
        </div>

        <div>
          <dt>Rarity</dt>
          <dd>{rarityLabel}</dd>
        </div>

        <div>
          <dt>Category</dt>
          <dd>{relic.category}</dd>
        </div>
      </dl>

      <p class='description'>{relic.appDescription}</p>
    </div>
  </article>

  {
    hasExtendedArchive && (
      <section class='archive-sections'>
        {relic.archiveEntry && (
          <details open>
            <summary>Archive entry</summary>
            <p>{relic.archiveEntry}</p>
          </details>
        )}

        {relic.curatorNote && (
          <details>
            <summary>Curator note</summary>
            <p>{relic.curatorNote}</p>
          </details>
        )}

        {relic.historicalInterpretation && (
          <details>
            <summary>Historical interpretation</summary>
            <p>{relic.historicalInterpretation}</p>
          </details>
        )}
      </section>
    )
  }

  {
    relic.routeHint && (
      <section class='route-hint'>
        <p class='eyebrow'>Recovery affinity</p>
        <h2>Where this relic may be encountered</h2>
        <p>{relic.routeHint}</p>
      </section>
    )
  }
  <nav class="relic-navigation" aria-label="Relic record navigation">
    {
      previousRelic ? (
        <a
          class="relic-navigation-link previous"
          href={`/archive/relics/${previousRelic.slug}`}
        >
          <span class="navigation-direction">← Previous record</span>
          <strong>
            {String(previousRelic.collectionNumber).padStart(2, "0")} ·{" "}
            {previousRelic.name}
          </strong>
        </a>
      ) : (
        <span class="relic-navigation-spacer" aria-hidden="true"></span>
      )
    }

    {
      nextRelic ? (
        <a
          class="relic-navigation-link next"
          href={`/archive/relics/${nextRelic.slug}`}
        >
          <span class="navigation-direction">Next record →</span>
          <strong>
            {String(nextRelic.collectionNumber).padStart(2, "0")} ·{" "}
            {nextRelic.name}
          </strong>
        </a>
      ) : (
        <span class="relic-navigation-spacer" aria-hidden="true"></span>
      )
    }
  </nav>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    margin-bottom: clamp(3rem, 8vw, 6rem);
    color: var(--colour-text-muted);
    font-size: 0.9rem;
    transition: color 160ms ease;
  }

  .back-link:hover {
    color: var(--colour-accent-bright);
  }

  .relic-record {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: center;
  }

  .artwork {
    aspect-ratio: 1;
    padding: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--colour-border);
    border-radius: 0.75rem;
    background:
      radial-gradient(
        circle at 50% 42%,
        rgba(202, 169, 104, 0.13),
        transparent 52%
      ),
      var(--colour-surface);
    color: var(--colour-text-muted);
    text-align: center;
  }

  .rarity-uncommon {
    border-color: rgba(202, 169, 104, 0.55);
  }

  .rarity-rare {
    border-color: rgba(226, 201, 143, 0.8);
    box-shadow: 0 0 3rem rgba(202, 169, 104, 0.1);
  }

  .rarity-centrepiece {
    border-color: var(--colour-accent-bright);
    box-shadow: 0 0 4rem rgba(202, 169, 104, 0.18);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--colour-accent-bright);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 2rem;
  }

  .metadata {
    margin: 0 0 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--colour-border);
  }

  .metadata div {
    padding: 1rem 0;
  }

  .metadata div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--colour-border);
  }

  .metadata dt {
    margin-bottom: 0.35rem;
    color: var(--colour-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .metadata dd {
    margin: 0;
    color: var(--colour-text);
  }

  .description {
    margin-bottom: 0;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .archive-sections {
    margin-top: clamp(5rem, 12vw, 9rem);
    border-top: 1px solid var(--colour-border);
  }

  details {
    border-bottom: 1px solid var(--colour-border);
  }

  summary {
    padding: 1.5rem 0;
    color: var(--colour-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    cursor: pointer;
  }

  details p {
    max-width: 52rem;
    padding-bottom: 1.5rem;
  }

  .route-hint {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
  }

  .route-hint h2 {
    margin-bottom: 1rem;
  }

  .route-hint p:last-child {
    margin-bottom: 0;
  }
    .relic-navigation {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--colour-border);
  }

  .relic-navigation-link {
    min-width: 0;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .relic-navigation-link:hover {
    border-color: var(--colour-accent-bright);
    transform: translateY(-2px);
  }

  .relic-navigation-link.next {
    text-align: right;
  }

  .navigation-direction {
    color: var(--colour-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .relic-navigation-link strong {
    overflow-wrap: anywhere;
    color: var(--colour-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  @media (max-width: 38rem) {
    .relic-navigation {
      grid-template-columns: 1fr;
    }

    .relic-navigation-spacer {
      display: none;
    }

    .relic-navigation-link.next {
      text-align: left;
    }
  }

  @media (max-width: 48rem) {
    .relic-record {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .metadata {
      grid-template-columns: 1fr;
    }

    .metadata div + div {
      padding-left: 0;
      border-top: 1px solid var(--colour-border);
      border-left: 0;
    }
  }
</style>
