---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { civilisations } from "../../data/civilisations";
import { relics } from "../../data/relics";

const totalRelicCount = civilisations.reduce(
  (total, civilisation) => total + civilisation.relicCount,
  0,
);

const totalCentrepieceCount = civilisations.reduce(
  (total, civilisation) => total + civilisation.centrepieceCount,
  0,
);

const cataloguedRelicCount = relics.length;

const catalogueProgress = Math.round(
  (cataloguedRelicCount / totalRelicCount) * 100,
);

const civilisationCollections = civilisations.map((civilisation, index) => {
  const availableRelics = relics.filter(
    (relic) => relic.civilisationSlug === civilisation.slug,
  );

  return {
    civilisation,
    collectionNumber: index + 1,
    availableCount: availableRelics.length,
    isComplete: availableRelics.length === civilisation.relicCount,
  };
});

const completedCollectionCount = civilisationCollections.filter(
  (collection) => collection.isComplete,
).length;
---

<BaseLayout
  title="The Relicbound Archive"
  description="Explore the lost civilisations and relic records catalogued through Relicbound expeditions."
>
  <section class="page-header">
    <p class="eyebrow">Public collection catalogue</p>

    <h1>The Relicbound Archive</h1>

    <p class="introduction">
      Explore the objects, cultures and unresolved histories recovered through
      Relicbound expeditions.
    </p>
  </section>

  <section class="summary" aria-label="Archive summary">
    <div>
      <strong>{cataloguedRelicCount}</strong>
      <span>Records online</span>
    </div>

    <div>
      <strong>{totalRelicCount}</strong>
      <span>Planned relics</span>
    </div>

    <div>
      <strong>{civilisations.length}</strong>
      <span>Civilisations</span>
    </div>

    <div>
      <strong>{totalCentrepieceCount}</strong>
      <span>Centrepieces planned</span>
    </div>
  </section>

  <section class="catalogue-progress" aria-labelledby="progress-heading">
    <div class="progress-copy">
      <div>
        <p class="eyebrow">Catalogue progress</p>

        <h2 id="progress-heading">
          {cataloguedRelicCount} of {totalRelicCount} records restored
        </h2>
      </div>

      <strong>{catalogueProgress}%</strong>
    </div>

    <div
      class="progress-track"
      role="progressbar"
      aria-label="Archive catalogue progress"
      aria-valuemin="0"
      aria-valuemax={totalRelicCount}
      aria-valuenow={cataloguedRelicCount}
    >
      <span style={`width: ${catalogueProgress}%`}></span>
    </div>
  </section>

  <section class="civilisations" aria-labelledby="civilisations-heading">
    <div class="section-heading">
      <p class="eyebrow">Collections</p>
      <h2 id="civilisations-heading">Browse by civilisation</h2>
    </div>

    <div class="civilisation-grid">
      {
        civilisationCollections.map(
          ({
            civilisation,
            collectionNumber,
            availableCount,
            isComplete,
          }) => (
            <a
              class="civilisation-card"
              href={`/archive/civilisations/${civilisation.slug}`}
            >
              <div class="card-heading">
                <span class="collection-number">
                  Collection {String(collectionNumber).padStart(2, "0")}
                </span>

                <span
                  class:list={[
                    "collection-status",
                    { complete: isComplete },
                  ]}
                >
                  {isComplete ? "Complete" : "In reconstruction"}
                </span>
              </div>

              <h3>{civilisation.name}</h3>

              <p>{civilisation.theme}</p>

              <div class="card-footer">
                <span class="relic-count">
                  {availableCount} of {civilisation.relicCount} records
                </span>

                <span aria-hidden="true">View collection →</span>
              </div>
            </a>
          ),
        )
      }
    </div>
  </section>

  <section class="archive-note">
    <div>
      <p class="eyebrow">Archive status</p>

      <h2>
        {completedCollectionCount === 1
          ? "The first collection is complete."
          : `${completedCollectionCount} collections are complete.`}
      </h2>
    </div>

    <div>
      <p>
        All Tideborn relic records are now available in the public archive.
        Remaining collections will open as their canonical museum data is
        completed.
      </p>

      <a href="/archive/civilisations/tideborn">
        Explore the complete Tideborn collection →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: 52rem;
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--colour-accent-bright);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .introduction {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .summary {
    margin-bottom: clamp(3rem, 8vw, 5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--colour-border);
  }

  .summary div {
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .summary div + div {
    border-left: 1px solid var(--colour-border);
  }

  .summary strong {
    color: var(--colour-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .summary span {
    color: var(--colour-text-muted);
    font-size: 0.85rem;
  }

  .catalogue-progress {
    margin-bottom: clamp(4rem, 10vw, 7rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
  }

  .progress-copy {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .progress-copy .eyebrow {
    margin-bottom: 0.75rem;
  }

  .progress-copy h2 {
    margin-bottom: 0;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .progress-copy > strong {
    flex: 0 0 auto;
    color: var(--colour-accent-bright);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .progress-track {
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--colour-background);
  }

  .progress-track span {
    height: 100%;
    display: block;
    border-radius: inherit;
    background: var(--colour-accent-bright);
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .civilisation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .civilisation-card {
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .civilisation-card:hover {
    transform: translateY(-0.25rem);
    border-color: var(--colour-accent);
    background: var(--colour-surface-raised);
  }

  .card-heading {
    margin-bottom: auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .collection-number {
    color: var(--colour-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .collection-status {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    color: var(--colour-text-muted);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .collection-status.complete {
    border-color: var(--colour-accent);
    color: var(--colour-accent-bright);
  }

  .civilisation-card h3 {
    margin: 3rem 0 1rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .civilisation-card > p {
    margin-bottom: 2rem;
  }

  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .relic-count {
    color: var(--colour-text);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .card-footer span:last-child {
    color: var(--colour-text-muted);
    font-size: 0.8rem;
    text-align: right;
  }

  .archive-note {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    gap: 3rem;
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
  }

  .archive-note h2,
  .archive-note p {
    margin-bottom: 0;
  }

  .archive-note a {
    margin-top: 1.25rem;
    display: inline-flex;
    color: var(--colour-accent-bright);
    font-weight: 700;
  }

  .archive-note a:hover {
    text-decoration: underline;
  }

  @media (max-width: 52rem) {
    .summary {
      grid-template-columns: repeat(2, 1fr);
    }

    .summary div:nth-child(3) {
      border-left: 0;
    }

    .summary div:nth-child(n + 3) {
      border-top: 1px solid var(--colour-border);
    }
  }

  @media (max-width: 42rem) {
    .civilisation-grid,
    .archive-note {
      grid-template-columns: 1fr;
    }

    .civilisation-card {
      min-height: 18rem;
    }

    .archive-note {
      gap: 1.5rem;
    }

    .progress-copy {
      align-items: flex-start;
    }
  }

  @media (max-width: 34rem) {
    .summary {
      grid-template-columns: 1fr;
    }

    .summary div + div,
    .summary div:nth-child(3) {
      border-top: 1px solid var(--colour-border);
      border-left: 0;
    }

    .progress-copy,
    .card-heading,
    .card-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .card-footer span:last-child {
      text-align: left;
    }
  }
</style>