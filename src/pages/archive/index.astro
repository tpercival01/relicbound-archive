---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { civilisations } from "../../data/civilisations";
---

<BaseLayout
  title="The Relicbound Archive"
  description="Explore the lost civilisations and relics catalogued through Relicbound expeditions."
>
  <section class="page-header">
    <p class="eyebrow">Public collection catalogue</p>

    <h1>The Relicbound Archive</h1>

    <p class="introduction">
      Explore the objects, cultures and unresolved histories recovered through
      Relicbound expeditions.
    </p>
  </section>

  <section class="summary" aria-label="Archive summary">
    <div>
      <strong>105</strong>
      <span>Relics</span>
    </div>

    <div>
      <strong>4</strong>
      <span>Civilisations</span>
    </div>

    <div>
      <strong>9</strong>
      <span>Centrepieces</span>
    </div>
  </section>

  <section class="civilisations" aria-labelledby="civilisations-heading">
    <div class="section-heading">
      <p class="eyebrow">Collections</p>
      <h2 id="civilisations-heading">Browse by civilisation</h2>
    </div>

    <div class="civilisation-grid">
      {
        civilisations.map((civilisation, index) => (
          <a
            class="civilisation-card"
            href={`/archive/civilisations/${civilisation.slug}`}
          >
            <span class="collection-number">
              Collection {String(index + 1).padStart(2, "0")}
            </span>

            <h3>{civilisation.name}</h3>

            <p>{civilisation.theme}</p>

            <span class="relic-count">
              {civilisation.relicCount} relics
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="archive-note">
    <div>
      <p class="eyebrow">Archive status</p>
      <h2>The catalogue is still being reconstructed.</h2>
    </div>

    <p>
      Individual relic entries, restoration records and historical
      interpretations will be added as the museum catalogue is prepared for
      launch.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: 52rem;
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--colour-accent-bright);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .introduction {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .summary {
    margin-bottom: clamp(4rem, 10vw, 7rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--colour-border);
  }

  .summary div {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .summary div + div {
    border-left: 1px solid var(--colour-border);
  }

  .summary strong {
    color: var(--colour-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .summary span {
    color: var(--colour-text-muted);
    font-size: 0.85rem;
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .civilisation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .civilisation-card {
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .civilisation-card:hover {
    transform: translateY(-0.25rem);
    border-color: var(--colour-accent);
    background: var(--colour-surface-raised);
  }

  .collection-number {
    margin-bottom: auto;
    color: var(--colour-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .civilisation-card h3 {
    margin: 3rem 0 1rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .civilisation-card p {
    margin-bottom: 2rem;
  }

  .relic-count {
    color: var(--colour-text);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .archive-note {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    gap: 3rem;
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
  }

  .archive-note h2,
  .archive-note p {
    margin-bottom: 0;
  }

  @media (max-width: 42rem) {
    .summary,
    .civilisation-grid,
    .archive-note {
      grid-template-columns: 1fr;
    }

    .summary div + div {
      border-top: 1px solid var(--colour-border);
      border-left: 0;
    }

    .civilisation-card {
      min-height: 18rem;
    }

    .archive-note {
      gap: 1.5rem;
    }
  }
</style>