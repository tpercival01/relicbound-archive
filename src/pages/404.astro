---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Record Not Found | Relicbound"
  description="The requested Relicbound archive record could not be found."
>
  <section class="not-found">
    <p class="eyebrow">Archive error · 404</p>

    <h1>This record has been lost.</h1>

    <p>
      The requested page may have moved, or the archive reference may be
      incorrect.
    </p>

    <div class="actions">
      <a class="primary-action" href="/archive">Return to the Archive</a>
      <a class="secondary-action" href="/">Relicbound home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 16rem);
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
    color: var(--colour-accent-bright);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .not-found > p:last-of-type {
    max-width: 38rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary-action,
  .secondary-action {
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--colour-accent);
    border-radius: 0.35rem;
    font-weight: 700;
  }

  .primary-action {
    background: var(--colour-accent);
    color: var(--colour-background);
  }

  .primary-action:hover {
    background: var(--colour-accent-bright);
    border-color: var(--colour-accent-bright);
  }

  .secondary-action {
    color: var(--colour-accent-bright);
  }

  .secondary-action:hover {
    background: rgba(202, 169, 104, 0.08);
    border-color: var(--colour-accent-bright);
  }

  @media (max-width: 34rem) {
    .actions,
    .primary-action,
    .secondary-action {
      width: 100%;
    }
  }
</style>