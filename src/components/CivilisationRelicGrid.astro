---
import type { Relic } from "../data/relics";
import RelicCard from "./RelicCard.astro";

interface Props {
  civilisationName: string;
  expectedRelicCount: number;
  relics: Relic[];
}

const { civilisationName, expectedRelicCount, relics } = Astro.props;
const isComplete = relics.length === expectedRelicCount;
---

<section class='collection' aria-labelledby='collection-heading'>
  <div class='section-heading'>
    <p class='eyebrow'>Collection catalogue</p>

    <h2 id='collection-heading'>
      {expectedRelicCount} relic records
    </h2>

    {
      isComplete ? (
        <p>
          All {expectedRelicCount} records from {civilisationName} are available
          in the public archive.
        </p>
      ) : relics.length > 0 ? (
        <p>
          {relics.length} of {expectedRelicCount} records from{" "}
          {civilisationName} are currently available in the public archive.
        </p>
      ) : (
        <p>
          The relic catalogue is ready to receive the canonical data export.
        </p>
      )
    }
  </div>

  {
    relics.length > 0 ? (
      <div class='relic-grid'>
        {relics.map((relic) => (
          <RelicCard relic={relic} />
        ))}
      </div>
    ) : (
      <div class='empty-state'>
        <strong>Archive records awaiting import</strong>

        <p>
          Individual relic entries will appear here when the shared catalogue is
          imported from the canonical Relicbound dataset.
        </p>
      </div>
    )
  }
</section>

<style>
  .collection {
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .section-heading {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--colour-accent-bright);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin-bottom: 1.25rem;
  }

  .relic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .empty-state {
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--colour-border);
    border-radius: 0.5rem;
    background: var(--colour-surface);
  }

  .empty-state strong {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--colour-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }

  .empty-state p {
    margin-bottom: 0;
  }

  @media (max-width: 54rem) {
    .relic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .relic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
